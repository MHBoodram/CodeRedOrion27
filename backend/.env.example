# Your Tiger connection string
DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/tsdb?sslmode=require

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Gemini (outfit analysis). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check this against Google's current model list; the code defaults to gemini-3.8-flash if unset
GEMINI_MODEL=gemini-3.8-flash
