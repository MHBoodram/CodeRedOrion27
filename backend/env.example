# Your Tiger connection string (get it from the Tiger Cloud console; never commit the real one)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=4000

# Comma-separated list of allowed frontend origins (only needed if the browser calls the API directly, not via the Vite proxy)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Outfit analysis (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
