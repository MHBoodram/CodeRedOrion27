{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": { "root": "client", "framework": "vite" },
    "api": { "root": "backend", "framework": "express" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}